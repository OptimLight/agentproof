{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/runstudio/agentproof/main/schemas/agentproof.receipt.schema.json",
  "title": "AgentProof receipt",
  "description": "Portable evidence receipt generated by AgentProof after a run.",
  "type": "object",
  "required": ["schema", "tool", "version", "generatedAt", "verdict", "score", "passed", "policy", "scan", "evidence"],
  "additionalProperties": true,
  "properties": {
    "schema": { "type": "string" },
    "tool": { "const": "AgentProof" },
    "version": { "type": "string" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "target": { "type": "string" },
    "verdict": { "type": "string" },
    "score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "passed": { "type": "boolean" },
    "policy": { "type": "object" },
    "scan": { "type": "object" },
    "evidence": { "type": "object" },
    "artifacts": { "type": "object" }
  }
}
