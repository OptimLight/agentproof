# Copie ce fichier en `.env` et remplis les valeurs. Ne commite JAMAIS le fichier .env.

# Domaine de ta boutique Shopify (sans https://)
SHOPIFY_STORE_DOMAIN=ma-boutique.myshopify.com

# Token Admin API de ta custom app Shopify (commence par shpat_)
# Voir README.md pour la création pas à pas.
SHOPIFY_ADMIN_TOKEN=remplace-par-ton-token-admin-shopify

# Auth Claude — remplis UNE des deux options :
# Option A : clé API classique (https://console.anthropic.com)
ANTHROPIC_API_KEY=remplace-par-ta-cle-anthropic
# Option B : réutiliser l'auth d'un agent existant (ex: ton conteneur Hermes) —
# token bearer/OAuth + endpoint éventuel de sa passerelle. Laisse alors
# ANTHROPIC_API_KEY vide.
#ANTHROPIC_AUTH_TOKEN=
#ANTHROPIC_BASE_URL=

# Langue de la boutique générée (fr, en, es...)
SHOP_LANGUAGE=fr

# Devise affichée dans le copy (EUR, USD...)
SHOP_CURRENCY=EUR
