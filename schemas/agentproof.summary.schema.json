{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/runstudio/agentproof/main/schemas/agentproof.summary.schema.json",
  "title": "AgentProof summary",
  "description": "Compact JSON summary generated by AgentProof for bots, dashboards, and agent harnesses.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "generatedAt",
    "target",
    "scanMode",
    "profile",
    "failUnder",
    "score",
    "verdict",
    "exitCode",
    "counts",
    "mode",
    "technical",
    "design",
    "findings",
    "suppressedFindings",
    "claim",
    "artifacts",
    "topFindings"
  ],
  "$defs": {
    "severity": {
      "type": "string",
      "enum": ["critical", "high", "medium", "low", "info"]
    },
    "nullableString": {
      "type": ["string", "null"]
    },
    "severityCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["critical", "high", "medium", "low", "info"],
      "properties": {
        "critical": { "type": "integer", "minimum": 0 },
        "high": { "type": "integer", "minimum": 0 },
        "medium": { "type": "integer", "minimum": 0 },
        "low": { "type": "integer", "minimum": 0 },
        "info": { "type": "integer", "minimum": 0 }
      }
    },
    "artifactPaths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report", "sarif", "badge", "html", "prComment", "receipt", "history", "summary"],
      "properties": {
        "report": { "$ref": "#/$defs/nullableString" },
        "sarif": { "$ref": "#/$defs/nullableString" },
        "badge": { "$ref": "#/$defs/nullableString" },
        "html": { "$ref": "#/$defs/nullableString" },
        "prComment": { "$ref": "#/$defs/nullableString" },
        "receipt": { "$ref": "#/$defs/nullableString" },
        "history": { "$ref": "#/$defs/nullableString" },
        "summary": { "$ref": "#/$defs/nullableString" }
      }
    }
  },
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/runstudio/agentproof/main/schemas/agentproof.summary.schema.json"
    },
    "schemaVersion": {
      "const": "agentproof.summary.v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "target": {
      "type": "string"
    },
    "scanMode": {
      "type": "string",
      "enum": ["full", "changed"]
    },
    "base": {
      "$ref": "#/$defs/nullableString"
    },
    "profile": {
      "type": "string",
      "enum": ["relaxed", "standard", "strict"]
    },
    "failUnder": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "verdict": {
      "type": "string",
      "enum": ["SHIP", "SHIP WITH CARE", "FIX BEFORE MERGE", "DESIGN REVIEW REQUIRED", "DO NOT SHIP"]
    },
    "exitCode": {
      "type": "integer",
      "enum": [0, 1]
    },
    "counts": {
      "$ref": "#/$defs/severityCounts"
    },
    "mode": {
      "type": "string",
      "enum": ["full", "design-only"]
    },
    "technical": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["score", "verdict", "exitCode", "counts"],
      "properties": {
        "score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "verdict": { "type": "string" },
        "exitCode": { "type": "integer", "enum": [0, 1] },
        "counts": { "$ref": "#/$defs/severityCounts" }
      }
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "type", "mode", "score", "verdict", "exitCode", "failUnder", "counts", "findings", "routes", "viewports", "screenshots"],
      "properties": {
        "enabled": { "type": "boolean" },
        "type": { "$ref": "#/$defs/nullableString" },
        "mode": { "type": "string" },
        "score": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
        "verdict": { "type": "string" },
        "exitCode": { "type": "integer", "enum": [0, 1] },
        "failUnder": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
        "counts": {
          "anyOf": [
            { "$ref": "#/$defs/severityCounts" },
            { "type": "null" }
          ]
        },
        "findings": { "type": "integer", "minimum": 0 },
        "routes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "viewports": {
          "type": "array",
          "items": { "type": "string" }
        },
        "screenshots": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "findings": {
      "type": "integer",
      "minimum": 0
    },
    "suppressedFindings": {
      "type": "integer",
      "minimum": 0
    },
    "baseline": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["path", "exists", "entries", "matched"],
      "properties": {
        "path": { "type": "string" },
        "exists": { "type": "boolean" },
        "entries": { "type": "integer", "minimum": 0 },
        "matched": { "type": "integer", "minimum": 0 }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audited", "source", "fromFile"],
      "properties": {
        "audited": { "type": "boolean" },
        "source": { "$ref": "#/$defs/nullableString" },
        "fromFile": { "type": "boolean" }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report", "sarif", "badge", "html", "prComment", "receipt", "history", "summary", "relative"],
      "properties": {
        "report": { "$ref": "#/$defs/nullableString" },
        "sarif": { "$ref": "#/$defs/nullableString" },
        "badge": { "$ref": "#/$defs/nullableString" },
        "html": { "$ref": "#/$defs/nullableString" },
        "prComment": { "$ref": "#/$defs/nullableString" },
        "receipt": { "$ref": "#/$defs/nullableString" },
        "history": { "$ref": "#/$defs/nullableString" },
        "summary": { "$ref": "#/$defs/nullableString" },
        "relative": { "$ref": "#/$defs/artifactPaths" }
      }
    },
    "topFindings": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "severity", "title", "file", "line"],
        "properties": {
          "id": { "type": "string" },
          "category": { "type": "string" },
          "severity": { "$ref": "#/$defs/severity" },
          "title": { "type": "string" },
          "file": { "$ref": "#/$defs/nullableString" },
          "line": { "type": ["integer", "null"], "minimum": 1 }
        }
      }
    }
  }
}
